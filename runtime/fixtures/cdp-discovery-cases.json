{
  "schema": "codex-dream-skin-cdp-discovery/1",
  "maxBytes": 262144,
  "maxTargets": 128,
  "maxTargetIdLength": 200,
  "maxUrlLength": 2048,
  "cases": [
    { "name": "list-valid", "resource": "/json/list", "body": "valid-list", "expect": "ok" },
    { "name": "list-count-128", "resource": "/json/list", "body": "list-count", "count": 128, "expect": "ok" },
    { "name": "list-count-129", "resource": "/json/list", "body": "list-count", "count": 129, "expect": "too-many-targets" },
    { "name": "list-id-200", "resource": "/json/list", "body": "list-boundary", "idLength": 200, "expect": "ok" },
    { "name": "list-id-201", "resource": "/json/list", "body": "list-boundary", "idLength": 201, "expect": "invalid-field" },
    { "name": "list-url-2048", "resource": "/json/list", "body": "list-boundary", "urlLength": 2048, "expect": "ok" },
    { "name": "list-url-2049", "resource": "/json/list", "body": "list-boundary", "urlLength": 2049, "expect": "invalid-field" },
    { "name": "list-ws-2048", "resource": "/json/list", "body": "list-boundary", "webSocketUrlLength": 2048, "expect": "ok" },
    { "name": "list-ws-2049", "resource": "/json/list", "body": "list-boundary", "webSocketUrlLength": 2049, "expect": "invalid-field" },
    { "name": "list-root-object", "resource": "/json/list", "body": "root-object", "expect": "root-type" },
    { "name": "list-missing-id", "resource": "/json/list", "body": "missing-id", "expect": "missing-field" },
    { "name": "list-wrong-id", "resource": "/json/list", "body": "wrong-id", "expect": "invalid-field" },
    { "name": "list-missing-websocket", "resource": "/json/list", "body": "missing-websocket", "expect": "missing-field" },
    { "name": "list-wrong-websocket", "resource": "/json/list", "body": "wrong-websocket", "expect": "invalid-field" },
    { "name": "list-exact-byte-limit", "resource": "/json/list", "body": "exact-byte-limit", "expect": "ok" },
    { "name": "version-valid", "resource": "/json/version", "body": "valid-version", "expect": "ok" },
    { "name": "version-escaped-text", "resource": "/json/version", "body": "version-escaped-text", "expect": "ok" },
    { "name": "version-root-array", "resource": "/json/version", "body": "version-array", "expect": "root-type" },
    { "name": "version-comment-prefix", "resource": "/json/version", "body": "version-comment-array", "expect": "malformed-json" },
    { "name": "version-missing-websocket", "resource": "/json/version", "body": "version-missing-websocket", "expect": "missing-field" },
    { "name": "version-wrong-websocket", "resource": "/json/version", "body": "version-wrong-websocket", "expect": "invalid-field" },
    { "name": "version-ws-2048", "resource": "/json/version", "body": "version-boundary", "webSocketUrlLength": 2048, "expect": "ok" },
    { "name": "version-ws-2049", "resource": "/json/version", "body": "version-boundary", "webSocketUrlLength": 2049, "expect": "invalid-field" },
    { "name": "declared-over-limit", "resource": "/json/list", "body": "malformed", "contentLength": "over-limit", "expect": "too-large" },
    { "name": "streamed-over-limit", "resource": "/json/list", "body": "stream-over-limit", "expect": "too-large" },
    { "name": "redirect", "resource": "/json/list", "body": "valid-list", "status": 302, "expect": "redirect" },
    { "name": "non-2xx", "resource": "/json/list", "body": "malformed", "status": 503, "expect": "http-status" },
    { "name": "invalid-utf8", "resource": "/json/list", "body": "invalid-utf8", "expect": "invalid-utf8" },
    { "name": "malformed-json", "resource": "/json/list", "body": "malformed", "expect": "malformed-json" }
  ]
}
